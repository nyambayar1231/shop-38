{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop-38-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5aca8a75fe664640a64b9a6775ba3057"
    }
  ]
